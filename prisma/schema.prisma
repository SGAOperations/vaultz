generator client {
    provider = "prisma-client-js"
    output   = "client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String    @id @default(uuid())
    first     String
    last      String
    createdAt DateTime  @default(now())
    deletedAt DateTime?

    purchases Purchase[]
}

model Designation {
    id   String @id @default(uuid())
    code String
    name String

    categories Category[]
}

model Category {
    id         String    @id @default(uuid())
    code       String
    ledgerCode String
    name       String
    amount     Decimal
    deletedAt  DateTime?

    designationId String
    designation   Designation  @relation(fields: [designationId], references: [id])

    purchases Purchase[]
}

model Purchase {
    id                   String   @id @default(uuid())
    amount               Decimal
    description          String
    notes                String?
    createdAt            DateTime @default(now())
    purchasedAt          DateTime @db.Date
    receipts             String[]
    excludeFromTotal     Boolean  @default(false)
    expenseReportCreated Boolean  @default(false)
    reimbursed           Boolean  @default(false)

    categoryId   String
    category     Category    @relation(fields: [categoryId], references: [id])
    allocationId String?
    allocation   Allocation? @relation(fields: [allocationId], references: [id])
    userId       String
    user         User        @relation(fields: [userId], references: [id])
    stepListId   String?
    stepList     StepList?   @relation(fields: [stepListId], references: [id])
    
    steps        PurchaseStep[]
}

model AllocationGroup {
    id   String @id @default(uuid())
    name String

    allocations Allocation[]
}

model Allocation {
    id     String  @id @default(uuid())
    name   String
    amount Decimal

    allocationGroupId String?
    allocationGroup   AllocationGroup? @relation(fields: [allocationGroupId], references: [id])

    purchases Purchase[]
}

model StepList {
    id        String   @id @default(uuid())
    name      String
    isDefault Boolean  @default(false)
    createdAt DateTime @default(now())

    steps     StepTemplate[]
    purchases Purchase[]
}

model StepTemplate {
    id         String   @id @default(uuid())
    name       String
    order      Int
    createdAt  DateTime @default(now())

    stepListId String
    stepList   StepList @relation(fields: [stepListId], references: [id], onDelete: Cascade)

    @@unique([stepListId, order])
    @@index([stepListId, order])
}

model PurchaseStep {
    id            String    @id @default(uuid())
    name          String
    order         Int
    completedAt   DateTime?
    skipped       Boolean   @default(false)
    createdAt     DateTime  @default(now())

    purchaseId    String
    purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

    @@unique([purchaseId, order])
    @@index([purchaseId, order])
}
