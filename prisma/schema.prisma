generator client {
    provider = "prisma-client-js"
    output   = "client"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String    @id @default(uuid())
    first     String
    last      String
    createdAt DateTime  @default(now())
    deletedAt DateTime?

    purchases Purchase[]
}

model Designation {
    id   String @id @default(uuid())
    code String
    name String

    categories Category[]
}

model Category {
    id         String    @id @default(uuid())
    code       String
    ledgerCode String
    name       String
    amount     Decimal
    deletedAt  DateTime?

    designationId String
    designation   Designation  @relation(fields: [designationId], references: [id])

    purchases Purchase[]
}

model Purchase {
    id                   String   @id @default(uuid())
    amount               Decimal
    description          String
    notes                String?
    createdAt            DateTime @default(now())
    purchasedAt          DateTime @db.Date
    receipts             String[]
    excludeFromTotal     Boolean  @default(false)
    expenseReportCreated Boolean  @default(false)
    reimbursed           Boolean  @default(false)

    categoryId   String
    category     Category    @relation(fields: [categoryId], references: [id])
    allocationId String?
    allocation   Allocation? @relation(fields: [allocationId], references: [id])
    userId       String
    user         User        @relation(fields: [userId], references: [id])
}

model AllocationGroup {
    id   String @id @default(uuid())
    name String

    allocations Allocation[]
}

model Allocation {
    id     String  @id @default(uuid())
    name   String
    amount Decimal

    allocationGroupId String?
    allocationGroup   AllocationGroup? @relation(fields: [allocationGroupId], references: [id])

    purchases Purchase[]
}
