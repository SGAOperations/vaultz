generator client {
    provider = "prisma-client-js"
    output   = "client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String    @id @default(uuid())
    first     String
    last      String
    createdAt DateTime  @default(now())
    deletedAt DateTime?

    purchases Purchase[]
}

model Designation {
    id   String @id @default(uuid())
    code String
    name String

    categories Category[]
}

model Category {
    id         String    @id @default(uuid())
    code       String
    ledgerCode String
    name       String
    amount     Decimal
    deletedAt  DateTime?

    designationId String
    designation   Designation  @relation(fields: [designationId], references: [id])

    purchases     Purchase[]
    transfersFrom Transfer[] @relation("TransferFromCategory")
    transfersTo   Transfer[] @relation("TransferToCategory")
}

model Purchase {
    id                   String   @id @default(uuid())
    amount               Decimal
    description          String
    createdAt            DateTime @default(now())
    purchasedAt          DateTime @db.Date
    receipts             String[]
    excludeFromTotal     Boolean  @default(false)
    expenseReportCreated Boolean  @default(false)
    reimbursed           Boolean  @default(false)

    categoryId   String
    category     Category    @relation(fields: [categoryId], references: [id])
    allocationId String?
    allocation   Allocation? @relation(fields: [allocationId], references: [id])
    userId       String
    user         User        @relation(fields: [userId], references: [id])
}

model AllocationGroup {
    id   String @id @default(uuid())
    name String

    allocations Allocation[]
}

model Allocation {
    id     String  @id @default(uuid())
    name   String
    amount Decimal

    allocationGroupId String?
    allocationGroup   AllocationGroup? @relation(fields: [allocationGroupId], references: [id])

    purchases         Purchase[]
    transfersFrom     Transfer[] @relation("TransferFromAllocation")
    transfersTo       Transfer[] @relation("TransferToAllocation")
}

model Transfer {
    id          String   @id @default(uuid())
    amount      Decimal
    description String
    createdAt   DateTime @default(now())

    fromCategoryId   String?
    fromCategory     Category?   @relation("TransferFromCategory", fields: [fromCategoryId], references: [id])
    toCategoryId     String?
    toCategory       Category?   @relation("TransferToCategory", fields: [toCategoryId], references: [id])
    fromAllocationId String?
    fromAllocation   Allocation? @relation("TransferFromAllocation", fields: [fromAllocationId], references: [id])
    toAllocationId   String?
    toAllocation     Allocation? @relation("TransferToAllocation", fields: [toAllocationId], references: [id])

    @@index([fromCategoryId])
    @@index([toCategoryId])
    @@index([fromAllocationId])
    @@index([toAllocationId])
}
