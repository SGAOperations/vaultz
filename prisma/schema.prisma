generator client {
    provider = "prisma-client-js"
    output   = "client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String    @id @default(uuid())
    first     String
    last      String
    createdAt DateTime  @default(now())
    deletedAt DateTime?

    purchases Purchase[]
}

model Index {
    id   String @id @default(uuid())
    code String
    name String

    accounts Account[]
}

model Account {
    id     String  @id @default(uuid())
    code   String
    name   String
    amount Decimal

    indexId String
    index   Index  @relation(fields: [indexId], references: [id])

    purchases Purchase[]
}

model Purchase {
    id          String   @id @default(uuid())
    amount      Decimal
    description String
    createdAt   DateTime @default(now())
    purchasedAt DateTime @db.Date
    receipts    String[]

    accountId    String
    account      Account     @relation(fields: [accountId], references: [id])
    allocationId String?
    allocation   Allocation? @relation(fields: [allocationId], references: [id])
    userId       String
    user         User        @relation(fields: [userId], references: [id])
}

model AllocationGroup {
    id   String @id @default(uuid())
    name String

    allocations Allocation[]
}

model Allocation {
    id     String  @id @default(uuid())
    name   String
    amount Decimal

    allocationGroupId String?
    allocationGroup   AllocationGroup? @relation(fields: [allocationGroupId], references: [id])

    purchases Purchase[]
}
