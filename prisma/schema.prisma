generator client {
    provider = "prisma-client-js"
    output   = "client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String    @id @default(uuid())
    first     String
    last      String
    createdAt DateTime  @default(now())
    deletedAt DateTime?

    purchases Purchase[]
}

model Designation {
    id   String @id @default(uuid())
    code String
    name String

    categories       Category[]
    allocations      Allocation[]
    allocationGroups AllocationGroup[]
}

model Category {
    id         String    @id @default(uuid())
    code       String
    ledgerCode String
    name       String
    amount     Decimal
    deletedAt  DateTime?

    designationId String
    designation   Designation  @relation(fields: [designationId], references: [id])

    purchases Purchase[]
}

model Purchase {
    id                   String   @id @default(uuid())
    amount               Decimal
    description          String
    notes                String?
    createdAt            DateTime @default(now())
    purchasedAt          DateTime @db.Date
    receipts             String[]
    excludeFromTotal     Boolean  @default(false)
    expenseReportCreated Boolean  @default(false)
    reimbursed           Boolean  @default(false)

    categoryId   String
    category     Category        @relation(fields: [categoryId], references: [id])
    allocationId String?
    allocation   Allocation?     @relation(fields: [allocationId], references: [id])
    userId       String
    user         User            @relation(fields: [userId], references: [id])

    process PurchaseProcess?
}

model ProcessTemplate {
    id          String    @id @default(uuid())
    name        String
    description String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime?

    steps    ProcessStep[]
    processes PurchaseProcess[]
}

model ProcessStep {
    id          String    @id @default(uuid())
    name        String
    description String?
    order       Int
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime?

    templateId  String
    template    ProcessTemplate @relation(fields: [templateId], references: [id])

    completions PurchaseStepCompletion[]
}

model PurchaseProcess {
    id         String    @id @default(uuid())
    startedAt  DateTime  @default(now())
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    deletedAt  DateTime?

    purchaseId String          @unique
    purchase   Purchase        @relation(fields: [purchaseId], references: [id])
    templateId String
    template   ProcessTemplate @relation(fields: [templateId], references: [id])

    completions PurchaseStepCompletion[]
}

model PurchaseStepCompletion {
    id                   String    @id @default(uuid())
    completed            Boolean   @default(false)
    markedAt             DateTime
    completionDate DateTime? @db.Date
    notes                String?
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt
    deletedAt            DateTime?

    purchaseProcessId String
    purchaseProcess   PurchaseProcess @relation(fields: [purchaseProcessId], references: [id])
    stepId            String
    step              ProcessStep     @relation(fields: [stepId], references: [id])
}

model AllocationGroup {
    id   String @id @default(uuid())
    name String

    designationId String
    designation   Designation @relation(fields: [designationId], references: [id])

    allocations Allocation[]
}

model Allocation {
    id     String  @id @default(uuid())
    name   String
    amount Decimal

    designationId     String
    designation       Designation      @relation(fields: [designationId], references: [id])
    allocationGroupId String?
    allocationGroup   AllocationGroup? @relation(fields: [allocationGroupId], references: [id])

    purchases Purchase[]
}
